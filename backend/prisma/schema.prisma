generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model Note {
  id                  BigInt                 @id @default(autoincrement()) @db.BigInt
  title               String                 @db.Text
  content             String                 @db.Text
  embedding           Unsupported("vector(1024)")?
  embeddingPending    Boolean                @default(false) @map("embedding_pending")
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  ownerId             String                 @map("owner_id") @db.Text
  ownerKind           String                 @map("owner_kind") @db.Text
  ownerUserId         BigInt?                @map("owner_user_id") @db.BigInt
  ownerGuestSessionId BigInt?                @map("owner_guest_session_id") @db.BigInt
  boardId             BigInt                 @map("board_id") @db.BigInt
  board               Board                  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  ownerUser           User?                  @relation("NoteOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerGuestSession   GuestSession?          @relation("NoteOwnerGuestSession", fields: [ownerGuestSessionId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)], map: "idx_notes_created_at")
  @@index([ownerId, updatedAt(sort: Desc)], map: "idx_notes_owner_updated_at")
  @@index([boardId, updatedAt(sort: Desc)], map: "idx_notes_board_updated_at")
  @@index([ownerUserId, updatedAt(sort: Desc)], map: "idx_notes_owner_user_updated_at")
  @@index([ownerGuestSessionId, updatedAt(sort: Desc)], map: "idx_notes_owner_guest_updated_at")
  @@map("notes")
}

model Board {
  id                  BigInt                @id @default(autoincrement()) @db.BigInt
  ownerId             String                @map("owner_id") @db.Text
  name                String                @db.Text
  shareTokenHash      String?               @unique(map: "idx_boards_share_token_hash_unique") @map("share_token_hash") @db.Text
  sharePermission     String                @default("view") @map("share_permission") @db.Text
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime              @default(now()) @map("updated_at") @db.Timestamptz(6)
  ownerKind           String                @map("owner_kind") @db.Text
  ownerUserId         BigInt?               @map("owner_user_id") @db.BigInt
  ownerGuestSessionId BigInt?               @map("owner_guest_session_id") @db.BigInt
  notes               Note[]
  collaborators       BoardCollaborator[]
  ownerUser           User?                 @relation("BoardOwnerUser", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerGuestSession   GuestSession?         @relation("BoardOwnerGuestSession", fields: [ownerGuestSessionId], references: [id], onDelete: Cascade)

  @@index([ownerId, updatedAt(sort: Desc)], map: "idx_boards_owner_updated_at")
  @@index([ownerUserId, updatedAt(sort: Desc)], map: "idx_boards_owner_user_updated_at")
  @@index([ownerGuestSessionId, updatedAt(sort: Desc)], map: "idx_boards_owner_guest_updated_at")
  @@map("boards")
}

model BoardCollaborator {
  id           BigInt   @id @default(autoincrement()) @db.BigInt
  boardId      BigInt   @map("board_id") @db.BigInt
  invitedEmail String   @map("invited_email") @db.Text
  permission   String   @db.Text
  userId       BigInt?  @map("user_id") @db.BigInt
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  board        Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([boardId, invitedEmail], map: "board_collaborators_board_id_email_key")
  @@index([invitedEmail], map: "idx_board_collaborators_email")
  @@index([boardId, permission], map: "idx_board_collaborators_board")
  @@index([userId, boardId], map: "idx_board_collaborators_user")
  @@map("board_collaborators")
}

model GuestSession {
  id              BigInt   @id @default(autoincrement()) @db.BigInt
  tokenHash       String   @unique(map: "guest_sessions_token_hash_key") @map("token_hash") @db.Text
  ownerId         String   @unique(map: "guest_sessions_owner_id_key") @map("owner_id") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  ownedBoards     Board[]  @relation("BoardOwnerGuestSession")
  ownedNotes      Note[]   @relation("NoteOwnerGuestSession")

  @@index([expiresAt], map: "idx_guest_sessions_expiry")
  @@map("guest_sessions")
}

model User {
  id                    BigInt                 @id @default(autoincrement()) @db.BigInt
  email                 String                 @db.Text
  name                  String                 @db.Text
  passwordHash          String                 @map("password_hash") @db.Text
  emailVerifiedAt       DateTime?              @map("email_verified_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @default(now()) @map("updated_at") @db.Timestamptz(6)
  authSessions          AuthSession[]
  actionTokens          AuthActionToken[]
  ownedBoards           Board[]                @relation("BoardOwnerUser")
  ownedNotes            Note[]                 @relation("NoteOwnerUser")
  collaborations        BoardCollaborator[]
  mcpAuthorizationCodes McpAuthorizationCode[]
  mcpAccessTokens       McpAccessToken[]
  mcpRefreshTokens      McpRefreshToken[]

  @@map("users")
}

/// A dynamically registered OAuth client (VS Code or another MCP client).
/// Public/PKCE-only clients are supported; no client secret is issued or stored.
model McpClient {
  id                 BigInt                 @id @default(autoincrement()) @db.BigInt
  clientId           String                 @unique(map: "mcp_clients_client_id_key") @map("client_id") @db.Text
  clientName         String?                @map("client_name") @db.Text
  redirectUris       String[]               @map("redirect_uris")
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  authorizationCodes McpAuthorizationCode[]
  accessTokens       McpAccessToken[]
  refreshTokens      McpRefreshToken[]

  @@map("mcp_clients")
}

/// A single-use Authorization Code issued after the resource owner authenticates,
/// bound to a PKCE code_challenge per RFC 7636.
model McpAuthorizationCode {
  id                  BigInt    @id @default(autoincrement()) @db.BigInt
  codeHash            String    @unique(map: "mcp_authorization_codes_code_hash_key") @map("code_hash") @db.Text
  clientId            BigInt    @map("client_id") @db.BigInt
  userId              BigInt    @map("user_id") @db.BigInt
  redirectUri         String    @map("redirect_uri") @db.Text
  codeChallenge        String   @map("code_challenge") @db.Text
  codeChallengeMethod  String   @default("S256") @map("code_challenge_method") @db.Text
  scopes               String[]
  resource             String?  @db.Text
  expiresAt            DateTime @map("expires_at") @db.Timestamptz(6)
  consumedAt           DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  client               McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt], map: "idx_mcp_authorization_codes_expiry")
  @@index([clientId], map: "idx_mcp_authorization_codes_client")
  @@map("mcp_authorization_codes")
}

/// An opaque bearer access token minted for a Synapse user + OAuth client, scoped
/// to a subset of the MCP tool scopes and (optionally) bound to a resource (RFC 8707).
model McpAccessToken {
  id           BigInt           @id @default(autoincrement()) @db.BigInt
  tokenHash    String           @unique(map: "mcp_access_tokens_token_hash_key") @map("token_hash") @db.Text
  clientId     BigInt           @map("client_id") @db.BigInt
  userId       BigInt           @map("user_id") @db.BigInt
  scopes       String[]
  resource     String?          @db.Text
  expiresAt    DateTime         @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime?        @map("revoked_at") @db.Timestamptz(6)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  client       McpClient        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken McpRefreshToken?

  @@index([userId, createdAt(sort: Desc)], map: "idx_mcp_access_tokens_user")
  @@index([expiresAt], map: "idx_mcp_access_tokens_expiry")
  @@map("mcp_access_tokens")
}

/// A refresh token paired 1:1 with the access token it was minted alongside.
model McpRefreshToken {
  id            BigInt          @id @default(autoincrement()) @db.BigInt
  tokenHash     String          @unique(map: "mcp_refresh_tokens_token_hash_key") @map("token_hash") @db.Text
  clientId      BigInt          @map("client_id") @db.BigInt
  userId        BigInt          @map("user_id") @db.BigInt
  scopes        String[]
  resource      String?         @db.Text
  accessTokenId BigInt?         @unique @map("access_token_id") @db.BigInt
  expiresAt     DateTime        @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?       @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  client        McpClient       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   McpAccessToken? @relation(fields: [accessTokenId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)], map: "idx_mcp_refresh_tokens_user")
  @@index([expiresAt], map: "idx_mcp_refresh_tokens_expiry")
  @@map("mcp_refresh_tokens")
}

model AuthSession {
  id             BigInt    @id @default(autoincrement()) @db.BigInt
  tokenHash      String    @unique(map: "auth_sessions_token_hash_key") @map("token_hash") @db.Text
  userId         BigInt    @map("user_id") @db.BigInt
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_auth_sessions_user")
  @@index([expiresAt], map: "idx_auth_sessions_expiry")
  @@map("auth_sessions")
}

model AuthActionToken {
  id          BigInt    @id @default(autoincrement()) @db.BigInt
  userId      BigInt    @map("user_id") @db.BigInt
  tokenHash   String    @unique(map: "auth_action_tokens_token_hash_key") @map("token_hash") @db.Text
  purpose     String    @db.Text
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt  DateTime? @map("consumed_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt(sort: Desc)], map: "idx_auth_action_tokens_user_purpose")
  @@index([expiresAt], map: "idx_auth_action_tokens_expiry")
  @@map("auth_action_tokens")
}