{
  "name": "@synapse/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "test": "tsx --test src/modules/auth/auth-http.test.ts src/modules/auth/rate-limit.service.test.ts src/modules/embeddings/openrouter-embeddings.service.test.ts src/observability/logger.test.ts",
    "test:integration": "tsx --test src/integration/notes.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^7.9.1",
    "@sentry/node": "^10.70.0",
    "@upstash/redis": "^1.38.2",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "prisma": "^7.9.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
