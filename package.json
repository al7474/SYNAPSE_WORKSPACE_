{
  "name": "SYNAPSE_WORKSPACE_",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "type": "module",
  "main": "index.js",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:migrate": "pnpm --filter @synapse/backend db:migrate",
    "db:migrate:dev": "pnpm --filter @synapse/backend db:migrate:dev",
    "db:reset": "pnpm --filter @synapse/backend db:reset",
    "db:seed": "pnpm --filter @synapse/backend db:seed",
    "dev": "pnpm -r --parallel --filter @synapse/backend --filter @synapse/frontend dev",
    "dev:backend": "pnpm --filter @synapse/backend dev",
    "dev:frontend": "pnpm --filter @synapse/frontend dev",
    "build": "pnpm -r --filter @synapse/* build",
    "test": "pnpm --filter @synapse/backend test",
    "smoke:embedding": "node --env-file=.env scripts/smoke/openrouter-embedding.js",
    "smoke:embedding:db": "node --env-file=.env scripts/smoke/openrouter-pgvector-e2e.js",
    "smoke:embedding:db:local": "node scripts/smoke/run-local-pgvector-e2e.js",
    "smoke:semantic": "node --env-file=.env scripts/smoke/semantic-search-smoke.js",
    "smoke:resilience": "node --env-file=.env scripts/smoke/resilience-fallback-smoke.js",
    "smoke:graphql": "node --env-file=.env scripts/smoke/graphql-base-smoke.js",
    "smoke:graphql:prisma": "node scripts/smoke/prisma-graphql-crud-smoke.js",
    "smoke:auth": "node scripts/smoke/auth-account-smoke.js",
    "smoke:auth:tokens": "pnpm --filter @synapse/backend exec tsx ../scripts/smoke/auth-token-smoke.ts",
    "smoke:graphql:subscription": "node --env-file=.env scripts/smoke/graphql-subscription-noteupdated-smoke.js",
    "smoke:autosave": "node --env-file=.env scripts/smoke/autosave-realistic-smoke.js",
    "smoke:foundation:local": "node scripts/smoke/run-local-foundation-smokes.js",
    "smoke:realtime:local": "node scripts/smoke/run-local-realtime-smokes.js",
    "smoke:db:up": "docker run -d --name synapse-pgvector-test -e POSTGRES_HOST_AUTH_METHOD=trust -e POSTGRES_DB=synapse_test -p 55432:5432 pgvector/pgvector:pg18",
    "smoke:db:down": "docker rm -f synapse-pgvector-test",
    "verify:env-templates": "node scripts/security/verify-env-templates.mjs",
    "secrets:scan": "node scripts/security/scan-secrets.mjs",
    "hooks:install": "node scripts/security/install-git-hooks.mjs",
    "ci:check": "pnpm verify:env-templates && pnpm secrets:scan && pnpm test && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@prisma/client": "6.19.0",
    "graphql": "^16.12.0",
    "pg": "^8.22.0"
  }
}
